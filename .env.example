# Neon connection string — get this from your Neon dashboard
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Generate a real one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string

# Razorpay dashboard (test mode) → Settings → API Keys. Starts with rzp_test_
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_key_secret

# Google AI Studio (aistudio.google.com/apikey) — free, no card needed
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-flash-lite-latest
